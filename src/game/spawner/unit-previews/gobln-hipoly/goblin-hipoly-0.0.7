// TOPOLOGY
class HEVertex {
    constructor(x,y,z){
        this.position =
            new THREE.Vector3(x,y,z);
        this.edge = null;
    }
}

class HEFace {
    constructor(){
        this.edge = null;
    }
}

class HEEdge {
    constructor(){
        this.vertex = null;
        this.face = null;
        this.next = null;
        this.prev = null;
        this.twin = null;
    }
}

class HalfEdgeMesh {
    constructor(){
        this.vertices = [];
        this.faces = [];
        this.edges = [];
    }
    createCube(size=1){
        const s = size;
        const verts = [
            [-s,-s,-s],
            [ s,-s,-s],
            [ s, s,-s],
            [-s, s,-s],

            [-s,-s, s],
            [ s,-s, s],
            [ s, s, s],
            [-s, s, s]
        ];

        for(const v of verts){
            this.vertices.push(
                new HEVertex(...v)
            );
        }

        if (!this.vertices[this.vertices.length - 1].edge) {
            this.vertices[this.vertices.length - 1].edge = null;
        }

        const quads = [
            [0,1,2,3],
            [4,5,6,7],

            [0,4,7,3],
            [1,5,6,2],

            [3,2,6,7],
            [0,1,5,4]
        ];

        const edgeMap = new Map();

        for(const quad of quads){
            const face =
                new HEFace();
            const e0 = new HEEdge();
            const e1 = new HEEdge();
            const e2 = new HEEdge();
            const e3 = new HEEdge();
            e0.vertex =
                this.vertices[quad[0]];
            e1.vertex =
                this.vertices[quad[1]];
            e2.vertex =
                this.vertices[quad[2]];
            e3.vertex =
                this.vertices[quad[3]];
            e0.next=e1;
            e1.next=e2;
            e2.next=e3;
            e3.next=e0;

            e0.prev=e3;
            e1.prev=e0;
            e2.prev=e1;
            e3.prev=e2;

            e0.face=face;
            e1.face=face;
            e2.face=face;
            e3.face=face;

            face.edge=e0;

            this.edges.push(
                e0,e1,e2,e3
            );

            this.faces.push(face);

            const edges = [
                [quad[0],quad[1],e0],
                [quad[1],quad[2],e1],
                [quad[2],quad[3],e2],
                [quad[3],quad[0],e3]
            ];

            for(const [a,b,e] of edges){
                const key =
                    `${a}_${b}`;
                const twinKey =
                    `${b}_${a}`;
                edgeMap.set(
                    key,
                    e
                );
                if(edgeMap.has(twinKey)){
                    const twin =
                        edgeMap.get(
                            twinKey
                        );
                    e.twin=twin;
                    twin.twin=e;
                }
            }
        }
    }
    buildGeometry(){
        const faceMap = [];
        const positions = [];
        for(const face of this.faces){
            faceMap.push(face);
            const verts = [];
            let edge =
                face.edge;
            do{
                verts.push(
                    edge.vertex.position
                );
                edge=edge.next;
            }
            while(edge!==face.edge);
            positions.push(
                verts[0].x,
                verts[0].y,
                verts[0].z,

                verts[1].x,
                verts[1].y,
                verts[1].z,

                verts[2].x,
                verts[2].y,
                verts[2].z
            );
            positions.push(
                verts[0].x,
                verts[0].y,
                verts[0].z,

                verts[2].x,
                verts[2].y,
                verts[2].z,

                verts[3].x,
                verts[3].y,
                verts[3].z
            );
        }
        const geometry =
            new THREE.BufferGeometry();
        geometry.setAttribute(
            "position",
            new THREE.Float32BufferAttribute(
                positions,
                3
            )
        );
        geometry.userData = {
            faceMap
        };
        geometry.computeVertexNormals();
        return geometry;
    }
    extrudeFace(face){
        if (!face || !face.edge) return;
        const newVerts = [];
        const newEdges = [];
        const newFaces = [];
        let startEdge = face.edge;
        let edge = startEdge;
        const faceVertices = [];
        // 1. collect loop vertices
        do{
            faceVertices.push(edge.vertex);
            edge = edge.next;
        } while(edge !== startEdge);

        console.log(faceVertices);
        
        // 2. compute normal (simple cross)
        const a = faceVertices[0].position;
        const b = faceVertices[1].position;
        const c = faceVertices[2].position;

        // const normal =
        //     new THREE.Vector3()
        //     .subVectors(b.position, a)
        //     .cross(
        //         new THREE.Vector3()
        //         .subVectors(c.position, a)
        //     )
        //     .normalize();

        // const normal =
        //     new THREE.Vector3()
        //     .subVectors(b, a)
        //     .cross(
        //         new THREE.Vector3().subVectors(c, a)
        //     )
        //     .normalize();

        const ab = new THREE.Vector3().subVectors(b, a);
        const ac = new THREE.Vector3().subVectors(c, a);

        const normal = new THREE.Vector3().crossVectors(ab, ac).normalize();
        
        // const ab = new THREE.Vector3().subVectors(b.position, a.position);
        // const ac = new THREE.Vector3().subVectors(c.position, a.position);

        // const normal = new THREE.Vector3().crossVectors(ab, ac).normalize();

        const faceCenter = new THREE.Vector3();
        for (const v of faceVertices) {
            faceCenter.add(v.position);
        }
        faceCenter.multiplyScalar(1 / faceVertices.length);

        const directionFromOrigin = faceCenter.clone().normalize();

        // IMPORTANT: correct sign
        if (normal.dot(directionFromOrigin) < 0) {
            normal.negate();
        }

        const offset = normal.multiplyScalar(0.8);

        // 3. duplicate vertices
        const dupVerts = faceVertices.map((v, i) => {
            const nv = new HEVertex(
                v.position.x + offset.x,
                v.position.y + offset.y,
                v.position.z + offset.z
            );
            this.vertices.push(nv);
            nv.edge = null;
            return nv;
        });

        // 4. create top face (new quad)
        const topFace = new HEFace();
        this.faces.push(topFace);

        const n = dupVerts.length;
        const topEdges = [];

        for(let i=0;i<n;i++){
            const e = new HEEdge();
            e.vertex = dupVerts[i];
            e.face = topFace;
            topEdges.push(e);
            this.edges.push(e);
            dupVerts[i].edge = e;
        }

        for(let i=0;i<n;i++){
            topEdges[i].next = topEdges[(i+1)%n];
            topEdges[i].prev = topEdges[(i-1+n)%n];
        }

        topFace.edge = topEdges[0];

        // 5. SIDE FACES (core of extrusion)
        for(let i=0;i<n;i++){

            const v0 = faceVertices[i];
            const v1 = faceVertices[(i+1)%n];
            const v2 = dupVerts[(i+1)%n];
            const v3 = dupVerts[i];

            const f = new HEFace();
            this.faces.push(f);

            const e0 = new HEEdge();
            const e1 = new HEEdge();
            const e2 = new HEEdge();
            const e3 = new HEEdge();

            e0.vertex = v0;
            if (!v0.edge) v0.edge = e0;
            e1.vertex = v1;
            if (!v1.edge) v1.edge = e1;
            e2.vertex = v2;
            if (!v2.edge) v2.edge = e2;
            e3.vertex = v3;
            if (!v3.edge) v3.edge = e3;

            e0.face = f;
            e1.face = f;
            e2.face = f;
            e3.face = f;

            e0.next = e1;
            e1.next = e2;
            e2.next = e3;
            e3.next = e0;

            e0.prev = e3;
            e1.prev = e0;
            e2.prev = e1;
            e3.prev = e2;

            f.edge = e0;

            this.edges.push(e0,e1,e2,e3);
        }

        // 6. REMOVE OLD FACE (we “replace” it)
        const idx = this.faces.indexOf(face);
        if(idx !== -1){
            this.faces.splice(idx,1);
        }
    }
}

// MESH SYSTEM
class MeshSystem {
    constructor(scene){
        this.scene = scene;
        this.topology = new HalfEdgeMesh();
        this.topology.createCube(1);
        this.createRenderMesh();
        this.selectedVertex = null;
        this.selectedFace = null;
        window.mesh = this.topology;
    }

    createRenderMesh(){
        const geo = this.topology.buildGeometry();
        const mat = new THREE.MeshStandardMaterial({
            color:0x6688aa,
            side:THREE.DoubleSide
        });

        this.mesh = new THREE.Mesh(geo,mat);
        this.geometry = geo;
        this.scene.add(this.mesh);
        const edgeGeo = new THREE.EdgesGeometry(geo);
        this.edgeLines = new THREE.LineSegments(
            edgeGeo,
            new THREE.LineBasicMaterial({
                color:0xff66aa
            })
        );
        this.scene.add(this.edgeLines);
        const pointMat = new THREE.PointsMaterial({
            color:0xffffff,
            size:0.08,
            sizeAttenuation:true
        });
        this.points = new THREE.Points(geo,pointMat);
        this.scene.add(this.points);
        this.mesh.geometry = geo;

        this.edgeLines.geometry = geo;
        this.points.geometry = geo;

        this.highlightMesh = this.mesh.clone();
        this.highlightMesh.material = new THREE.MeshBasicMaterial({
            color:0xffaa00,
            transparent:true,
            opacity:0.5,
            side:THREE.DoubleSide
        });

        this.highlightMesh.visible = false;
        this.scene.add(this.highlightMesh);
        this.faceColors =new Float32Array(
            this.geometry.attributes.position.count * 3
        );
    }
    rebuild(){
        const geo =
            this.topology.buildGeometry();
        this.mesh.geometry = geo;
        this.edgeLines.geometry = geo;
        this.points.geometry = geo;
        this.geometry = geo;
    }
