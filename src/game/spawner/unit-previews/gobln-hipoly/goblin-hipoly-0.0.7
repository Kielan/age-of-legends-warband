window.addEventListener("keydown",(e)=>{
    if(e.key === "e"){
        const faceIndex =
            APP.selected.face;
        if(faceIndex === null) return;
        const face = APP.selected.face;
        if (!face) return;
        APP.meshSystem.topology.extrudeFace(face);
        APP.meshSystem.rebuild();
    }
});

}

initHelpers(){
const grid =new THREE.GridHelper(50,50);
this.scene.add(grid);
const axes =new THREE.AxesHelper(2);
this.scene.add(axes);
const ambient = new THREE.AmbientLight(0xffffff,1);
this.scene.add(ambient);
const sun = new THREE.DirectionalLight(0xffffff,2);
sun.position.set(10,10,5);
this.scene.add(sun);
this.meshSystem = new MeshSystem(this.scene);
}

